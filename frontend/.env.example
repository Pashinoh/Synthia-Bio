# SynthiaBio Frontend Environment
# Copy to frontend/.env.local for local development or set in your hosting provider (Vercel/Netlify).

# Server-side URL of the SynthiaBio Express backend API used by the same-origin /api/backend/* BFF proxy
BACKEND_API_URL=http://localhost:5000

# Server-only shared secret sent as X-API-Key to the Express backend (NEVER prefix with NEXT_PUBLIC_)
SYNTHIA_API_KEY=replace_with_a_strong_random_secret

# Optional: only used by the built-in Next.js /api/generate fallback route if the Express backend is unreachable
# GEMINI_API_KEY=your_gemini_api_key_here
