# ==============================================================================
# SynthiaBio — Environment Configuration Overview
# ==============================================================================
# For local development or deployment, copy the service-specific templates:
#   - Backend  : backend/.env.example  -> backend/.env
#   - Frontend : frontend/.env.example -> frontend/.env.local
#
# Backend AI & Security Variables (backend/.env):
PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
ALLOWED_ORIGINS=http://localhost:3000

# Frontend API Endpoint (frontend/.env.local):
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000

# Note: If no AI API keys are supplied, SynthiaBio gracefully falls back to its
# deterministic biophysical heuristic engine so the app never crashes during demo.
