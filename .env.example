# ==============================================================================
# SynthiaBio — Environment Configuration Overview
# ==============================================================================
# For local development or deployment, copy the service-specific templates:
#   - Backend  : backend/.env.example  -> backend/.env
#   - Frontend : frontend/.env.example -> frontend/.env.local
#
# Shared Server-to-Server API Auth Key (set identically in backend & frontend server env; NEVER NEXT_PUBLIC_):
SYNTHIA_API_KEY=replace_with_a_strong_random_secret

# Backend AI & Security Variables (backend/.env):
PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1

# Optional Distributed Rate Limit Store (backend/.env):
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Frontend Server BFF Proxy Target (frontend/.env.local):
BACKEND_API_URL=http://localhost:5000

# Note: If no AI API keys are supplied, SynthiaBio gracefully falls back to its
# deterministic biophysical heuristic engine so the app never crashes during demo.
