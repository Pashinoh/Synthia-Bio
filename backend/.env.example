# SynthiaBio Backend Environment
PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Security, Authentication, CORS & Rate Limiting
# Shared server-to-server secret (REQUIRED in production; set the same value in frontend server env)
SYNTHIA_API_KEY=replace_with_a_strong_random_secret

# Comma-separated browser origins permitted for direct cross-origin requests.
# Fails closed (rejects cross-origin browser requests) when left empty.
ALLOWED_ORIGINS=http://localhost:3000

# Number of trusted reverse-proxy hops in front of Express (1 for Railway/Render/Nginx, 0 if directly exposed)
TRUST_PROXY_HOPS=1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
AI_RATE_LIMIT_MAX=15

# Optional distributed sliding-window rate limiter via Upstash Redis REST API (multi-instance production)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
