{
  "name": "synthia-bio",
  "version": "1.0.0",
  "private": true,
  "description": "SynthiaBio: Autonomous De Novo Antimicrobial Peptide Designer (STEM2Connect Hackathon 2026)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:fe": "npm --prefix frontend run dev",
    "dev:be": "npm --prefix backend run dev",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,emerald\" \"npm run dev:be\" \"npm run dev:fe\"",
    "build": "npm --prefix frontend run build",
    "build:be": "npm --prefix backend run build",
    "test:be": "npm --prefix backend test",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
