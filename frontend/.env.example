# SynthiaBio Frontend Environment
# Copy to frontend/.env.local for local development or set in your hosting provider (Vercel/Netlify).

# Public URL of the SynthiaBio Express backend API (trailing slashes are stripped automatically)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000

# Optional: only used by the built-in Next.js /api/generate fallback route if the Express backend is unreachable
# GEMINI_API_KEY=your_gemini_api_key_here
